# Which country this admin instance edits, and where its bundle is published.
# No value here has a default: see requireEnv in scripts/ and functions/.
#
# Poland
#   NEXT_PUBLIC_COUNTRY_CODE=PL
#   COUNTRY_CODE=PL
#   HOSTING_SITE_ID=roadready-pl
#   PUBLISH_SERVICE_ACCOUNT=firebase-adminsdk-fbsvc@roadready-pl.iam.gserviceaccount.com
#
# Italy
#   NEXT_PUBLIC_COUNTRY_CODE=IT
#   COUNTRY_CODE=IT
#   HOSTING_SITE_ID=roadready-it
#   PUBLISH_SERVICE_ACCOUNT=firebase-adminsdk-fbsvc@roadready-it.iam.gserviceaccount.com
#
# The Firebase web config below belongs to the same project as the country
# above. Pointing them at different projects is the one mistake this file
# cannot catch for you.
NEXT_PUBLIC_COUNTRY_CODE=
COUNTRY_CODE=
HOSTING_SITE_ID=
PUBLISH_SERVICE_ACCOUNT=

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
